        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~edu\.sezg534\.ratelimiter\.(limiter\.RateLimiterService|web\.RateLimitFilter)"/>
    </Match>
</FindBugsFilter>
